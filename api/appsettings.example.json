{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=mydb;Username=postgres;Password=your_password"
  },
  "AllowedHosts": "*",
  "JWT": {
    "Issuer": "https://localhost:7157",
    "Audience": "https://localhost:7157",
    "SigningKey": "replace-with-a-long-development-only-key_1234567890987654321012345",
    "ExpirationMinutes": 15
  },
  "RefreshToken": {
    "ExpirationDays": 14,
    "Length": 64
  },
  "Cache": {
    "BanUserTtl": "00:05:00"
  },
  "Seed": {
    "AdminEmail": "admin@example.com",
    "AdminPassword": "replace-with-a-development-password"
  },
  "RateLimiting": {
    "Global": {
      "PermitLimit": 100,
      "WindowSeconds": 10
    },
    "Auth": {
      "PermitLimit": 5,
      "WindowSeconds": 60
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  }
}